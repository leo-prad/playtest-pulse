+/* Connection tab: single comfortable-width card */
+#tab-connection .grid { grid-template-columns: minmax(0, 480px); }
+
+/* ---------- events-over-time chart ---------- */
+.chart-hint { font-family: var(--mono); font-size: 12px; color: var(--muted); }
+.chart { width: 100%; }
+.chart-svg { width: 100%; height: 180px; display: block; }
+.chart-line { fill: none; stroke: var(--signal); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
+.chart .dot { fill: var(--signal); }
+.chart .grid { stroke: var(--border); stroke-width: 1; }
+.chart .ytick { fill: var(--muted); font-family: var(--mono); font-size: 9px; text-anchor: end; }
+.chart .xtick { fill: var(--muted); font-family: var(--mono); font-size: 9px; }
