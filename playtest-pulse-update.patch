+.col-server { width: 150px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.col-event { width: 170px; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.col-data { flex: 1; min-width: 0; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.et-cell.mono { font-family: var(--mono); }
+
+/* sortable headers */
+button.et-cell.sortable {
+  background: transparent; border: none; color: inherit; cursor: pointer;
+  font: inherit; text-transform: inherit; letter-spacing: inherit;
+  display: flex; align-items: center; gap: 4px; padding: 0;
+}
+button.et-cell.sortable:hover { color: var(--text); }
+button.et-cell.sortable.active { color: var(--signal); }
+.sort-arrow { font-size: 11px; }
+
+/* column hide toggles */
+.events-table.hide-time .col-time,
+.events-table.hide-player .col-player,
+.events-table.hide-server .col-server,
+.events-table.hide-data .col-data { display: none; }
 
 /* ---------- tabs ---------- */
 .tabs { display: flex; gap: 4px; margin-bottom: 18px; border-bottom: 1px solid var(--border); }
