# Copy to .env (or export these) — all optional for local dev.
PORT=3000
# Secret used to sign dashboard JWTs. CHANGE THIS before deploying.
JWT_SECRET=change-me-to-a-long-random-string
# Where the local JSON data file lives.
DB_PATH=pulse.data.json
# Optional: enables LLM-grade feedback theme extraction. Without it, a local
# keyword fallback is used instead.
ANTHROPIC_API_KEY=
# Public URL used by OAuth providers after deployment.
APP_URL=http://localhost:3000
# Generate these separately from JWT_SECRET in production.
OAUTH_SESSION_SECRET=change-me-to-a-second-long-random-string
# OAuth credentials: keep values in your host's encrypted environment settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
